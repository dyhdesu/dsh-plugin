{
  "name": "@mzzsfy/dsh-toast",
  "description": "全局浮出通知 Toast 库:多条并存栈式展示,info/ok/error 三色,自动消失与常驻确认两种生命周期;普通 npm 依赖(非 dsh 插件),宿主占位条目由唯一授权消费插件代挂,其余插件可选消费",
  "version": "0.2.5",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "unknown"
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "src",
    "test",
    "README.md",
    "MECHANISM.md"
  ]
}
