{
  "name": "@mzzsfy/dsh-maintain",
  "description": "DSH 自身的版本管理:追踪 npm dist-tag 通道新版本、查看 GitHub Releases 更新内容、活跃工作门控与安全重启;受管升级在候选宿主健康探针就绪前保持禁用",
  "version": "0.13.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@mzzsfy/dsh-toast/client"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "unknown"
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "npmPublish": "npm publish --access public --provenance=false --registry=https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzzsfy/dsh-plugin.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mzzsfy/dsh-toast": "^0.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4",
    "react": "^18.2.0"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md"
  ]
}
